    "@shadcn/react": "^0.3.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
