{
  "name": "qura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config=./src/db/config.ts",
    "db:push": "drizzle-kit push --config=./src/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/db/config.ts",
    "db:studio": "drizzle-kit studio --config=./src/db/config.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:evaluate-discovery": "tsx --conditions=react-server --env-file=.env src/db/evaluate-discovery.ts",
    "db:evaluate-unified-search": "tsx --conditions=react-server --env-file=.env src/db/evaluate-unified-search.ts",
    "db:evaluate-search-ranking-proposal": "tsx --conditions=react-server --env-file=.env src/db/evaluate-search-ranking-proposal.ts",
    "db:evaluate-google-place-conversion": "tsx --conditions=react-server --env-file=.env src/db/evaluate-google-place-conversion.ts",
    "db:evaluate-category-city-scope": "tsx --conditions=react-server --env-file=.env src/db/evaluate-category-city-scope.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "postgres": "3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
