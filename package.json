{
  "name": "qura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate --config=src/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/config.ts",
    "db:push": "drizzle-kit push --config=src/db/config.ts",
    "db:studio": "drizzle-kit studio --config=src/db/config.ts",
    "db:seed": "tsx --conditions=react-server src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
