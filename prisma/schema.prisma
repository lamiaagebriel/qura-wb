// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @map("_id")
  sessions Session[]

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // google auth 

  createdAt DateTime @default(now())

  stores Store[]
  orders Order[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

model Store {
  id        String    @id @map("_id")
  userId    String
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  name     String
  products Product[]
  orders   Order[]

  @@map("stores")
}

model Product {
  id        String    @id @map("_id")
  storeId   String
  store     Store     @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  name   String
  orders OrderProductDetails[]

  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERING
  DELIVERED
}

model Order {
  id        String    @id @map("_id")
  storeId   String
  store     Store     @relation(references: [id], fields: [storeId], onDelete: Cascade)
  userId    String
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  status   OrderStatus           @default(PENDING)
  products OrderProductDetails[]

  @@map("orders")
}

model OrderProductDetails {
  id        String @id @map("_id")
  orderId   String
  productId String

  size String

  order   Order   @relation(references: [id], fields: [orderId], onDelete: Cascade)
  product Product @relation(references: [id], fields: [productId], onDelete: Cascade)

  @@unique([orderId, productId])
  @@map("order-product-details")
}
