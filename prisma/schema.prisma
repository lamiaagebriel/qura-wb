// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @map("_id")
  sessions  Session[]
  createdAt DateTime  @default(now())

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // googleAuth

  stores Store[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

model Store {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name     String
  username String  @unique
  bio      String?
  logo     String?
  category String
  location Json
  pages    Json[]  @default([])

  products Product[]

  @@map("stores")
}

// store -- products
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVE
}

model Product {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name        String
  slug        String?       @unique
  description String?
  status      ProductStatus @default(DRAFT)
  images      String[]      @default([])

  price Int
  stock Int

  attributes Json

  @@map("products")
}
