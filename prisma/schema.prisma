// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @map("_id")
  sessions  Session[]
  createdAt DateTime  @default(now())

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // googleAuth

  stores  Store[]
  orders  Order[]
  reviews Review[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

model Store {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name     String
  category String
  currency String? // base currency
  language String? // base language

  username String @unique

  bio      String?
  logo     String?
  location Json

  products Product[]
  pages    Page[]
  orders   Order[]

  @@map("stores")
}

model Page {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  url   String
  title String
  body  String?

  @@unique([storeId, url])
  @@map("pages")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVE
}

model Product {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  title       String
  slug        String  @unique
  description String?

  status ProductStatus @default(DRAFT)

  images String[] @default([])

  price    Int
  discount Int?
  cost     Int?

  tax Int? // default to 0

  stock                 Int? // limited amount || always avaliable
  limitedAmountPerOrder Int?

  attributes Json[]   @default([]) // {name: string, desc?: string, values: string[]}
  // compinations Json // cost, price, discount, stock, isAlwaysAvailable
  // الخصائص، نوع الكاميرا ....
  // properties // {name: brand, value: Apple}
  reviews    Review[]

  @@map("products")
}

// not yet
enum OrderStatus {
  PENDING
  CONFIRMED
  DECLINED
  DELIVERYING
  DELIVERYED
  CANCELLED
}

model Order {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  details Json
  status  OrderStatus @default(PENDING)

  @@map("orders")
}

model Review {
  id        String   @id @map("_id")
  productId String
  product   Product  @relation(references: [id], fields: [productId], onDelete: Cascade)
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  content String
  rating  Int // (e.g., 1-5 stars)

  @@map("reviews")
}
