// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @map("_id")
  sessions  Session[]
  createdAt DateTime  @default(now())

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // googleAuth

  stores Store[]
  orders Order[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

enum CURRENCY {
  EGY
  US
  SAR
}

enum LANGUAGE {
  EN
  AR
}

model Store {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name     String
  username String  @unique
  bio      String?
  logo     String?
  category String
  // currency  CURRENCY
  // languages LANGUAGE // [] @default([])
  location Json

  products Product[]
  pages    Page[]
  orders   Order[]

  @@map("stores")
}

model Page {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  url         String
  title       String
  description String?
  body        String?

  @@unique([storeId, url])
  @@map("pages")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVE
}

model Product {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  images      String[]      @default([])

  cost     Int?
  price    Int
  discount Int?
  stock    Int
  // isAlwaysAvailable

  attributes Json

  // compinations Json // cost, price, discount, stock, isAlwaysAvailable
  // الخصائص، نوع الكاميرا ....

  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DECLINED
  DELIEVERING
  DELIEVERED
  CANCELED
}

model Order {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  details Json
  status  OrderStatus @default(PENDING)

  @@map("orders")
}
