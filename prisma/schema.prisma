// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @map("_id")
  sessions Session[]

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // google auth 

  createdAt DateTime @default(now())

  Store Store[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

model Store {
  id     String @id @map("_id")
  userId String
  name   String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  products Product[]

  @@map("stores")
}

model Product {
  id      String @id @map("_id")
  storeId String
  name    String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  store Store @relation(references: [id], fields: [storeId], onDelete: Cascade)

  @@map("products")
}
