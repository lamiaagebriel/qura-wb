generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @map("_id")
  sessions  Session[]
  createdAt DateTime  @default(now())

  name     String
  email    String  @unique
  image    String?
  password String? // creadentials
  googleId String? // googleAuth

  stores Store[]

  @@map("users")
}

model Session {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  expiresAt DateTime

  @@map("sessions")
}

model Store {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name String

  products Product[]

  @@map("stores")
}

model Product {
  id        String   @id @map("_id")
  storeId   String
  store     Store    @relation(references: [id], fields: [storeId], onDelete: Cascade)
  createdAt DateTime @default(now())

  name       String
  images     String[] @default([])
  attributes Json

  @@map("products")
}

