# Copy to `.env` and fill in. This file is committed — never put real secrets here.

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Used by the app. Locally: `docker compose up -d` (see compose.yaml) matches this default.
# Production (serverless): use the provider's connection *pooler* URL
# (e.g. Supabase > Connection pooling, port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/qura

# Optional. Direct (non-pooled) URL used only by drizzle-kit for migrations,
# since poolers don't handle DDL well. Falls back to DATABASE_URL.
DIRECT_URL=

# Optional. Connections per server instance (default 1 for serverless).
DATABASE_POOL_MAX=

# -----------------------------------------------------------------------------
# App & auth (Better Auth)
# -----------------------------------------------------------------------------
# Public base URL of the app, no trailing slash. Used for OAuth redirects.
APP_URL=http://localhost:3000

# Signs session cookies. Generate: `openssl rand -base64 32` (min 32 chars).
# Use a different value per environment; rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Optional. Other origins the app is opened from, comma-separated, full URLs.
# Auth builds its URLs from whichever of these (or APP_URL) the request came
# in on, so you stay on the same address after signing in. In dev they're
# also allowed to load the dev server (next.config.ts).
# Examples: a phone on the LAN (http://192.168.1.13:3000), an HTTPS tunnel
# (https://qura-dev.ngrok.app), a Vercel preview (https://qura-git-x.vercel.app).
# Google only accepts localhost or HTTPS domains as redirect URIs — add
# ${origin}/api/auth/callback/google in the Cloud Console for each one.
TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Google sign-in (required — the only sign-in method)
# -----------------------------------------------------------------------------
# Google Cloud Console setup (https://console.cloud.google.com):
# 1. APIs & Services > OAuth consent screen: choose "External", fill in the
#    app name, support email and developer contact. Scopes: openid, email,
#    profile (the defaults). While in "Testing", add your Google account under
#    Test users; publish the app before going live.
# 2. APIs & Services > Credentials > Create credentials > OAuth client ID >
#    Application type "Web application".
# 3. Authorized JavaScript origins:
#      http://localhost:3000
#      ${APP_URL}                     (your production URL)
# 4. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      ${APP_URL}/api/auth/callback/google
# 5. Copy the Client ID and Client secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
