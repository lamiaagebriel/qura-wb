
# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Base URL of the app — used to build absolute links in emails and OAuth
# redirect URIs. No trailing slash.
APP_URL=

# Extra origins Better Auth should accept requests from, beyond APP_URL —
# comma-separated, no spaces needed. Only needed for local dev when you're
# hitting the dev server from something other than localhost (e.g. your
# phone over the LAN, `http://192.168.x.x:3000`) — without it, sign-in
# fails with "Invalid origin". Leave blank otherwise; never needed in prod.
TRUSTED_ORIGINS=

# Better Auth's own signing secret (sessions, tokens). Generated with
# `openssl rand -base64 32` — rotate this for production, don't reuse it.
BETTER_AUTH_SECRET=

# Secures the /api/cron/cleanup route (expired session/verification rows).
# Vercel sets this automatically for Cron Jobs on deploy — you only need
# to set it yourself for local testing. Leave blank locally to skip the
# check entirely.
CRON_SECRET=
# -----------------------------------------------------------------------------
# Database (SQL - Postgres)
# -----------------------------------------------------------------------------
# Postgres connection string used by the Drizzle db client (and by the
# drizzle-kit CLI when DIRECT_URL is unset).
# Locally: your own Postgres, direct connection (port 5432) is fine.
# In production (Vercel): use Supabase's connection *pooler* string instead
# — Project Settings > Database > Connection pooling, port 6543 — not the
# direct connection. See the comment in `src/db/index.ts` for why.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qura

# Optional. Connection string used only by the drizzle-kit CLI
# (`db:push`/`db:generate`/`db:migrate`); falls back to DATABASE_URL.
# Transaction-mode poolers (Supabase's port 6543) break drizzle-kit's schema
# introspection and DDL, so when DATABASE_URL points at one, set this to the
# pooler's *session*-mode port (5432, same host and credentials) or the
# direct connection. Leave unset locally.
DIRECT_URL=

# -----------------------------------------------------------------------------
# OAuth (Google Auth)
# -----------------------------------------------------------------------------
# Google OAuth — leave blank to disable Google sign-in locally.
# Authorized redirect URI changed with the Better Auth migration — update
# this in the Google Cloud console:
# Google OAuth (console.cloud.google.com > APIs & Services > Credentials). 
#   ${APP_URL}/api/auth/callback/google 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Google Places (server-only — Places API (New))
# -----------------------------------------------------------------------------
# Server-side secret used only by `src/lib/google-places/` — NEVER prefix
# this with NEXT_PUBLIC_ (that would ship it to every browser bundle).
# Distinct from any NEXT_PUBLIC_ Google Maps key used client-side for
# rendering maps — this one is never read outside server code. Leave blank
# to disable the integration entirely: search/details calls fail with a
# typed "not configured" error instead of crashing the app.
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Mailing (Gmail Nodemailer)
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465  # 465=secure, 587=non-secure
SMTP_USER=
SMTP_PASSWORD= # 16-char app password (no spaces)


# -----------------------------------------------------------------------------
# AWS Spaces 
# -----------------------------------------------------------------------------
 
AWS_SPACE_ACCESS_KEY_ID=
AWS_SPACE_ACCESS_SECRET_KEY=
AWS_SPACE_REGION=
AWS_SPACE_BUCKET=