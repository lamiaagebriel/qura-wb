# Copy to `.env` and fill in. This file is committed — never put real secrets here.

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Used by the app. Locally: `docker compose up -d` (see compose.yaml) matches this default.
# Production (serverless): use the provider's connection *pooler* URL
# (e.g. Supabase > Connection pooling, port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/qura

# Optional. Direct (non-pooled) URL used only by drizzle-kit for migrations,
# since poolers don't handle DDL well. Falls back to DATABASE_URL.
DIRECT_URL=

# Optional. Connections per server instance (default 1 for serverless).
DATABASE_POOL_MAX=
