
# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Base URL of the app — used to build absolute links in emails and OAuth
# redirect URIs. No trailing slash.
APP_URL=

# Extra origins Better Auth should accept requests from, beyond APP_URL —
# comma-separated, no spaces needed. Only needed for local dev when you're
# hitting the dev server from something other than localhost (e.g. your
# phone over the LAN, `http://192.168.x.x:3000`) — without it, sign-in
# fails with "Invalid origin". Leave blank otherwise; never needed in prod.
TRUSTED_ORIGINS=

# Better Auth's own signing secret (sessions, tokens). Generated with
# `openssl rand -base64 32` — rotate this for production, don't reuse it.
BETTER_AUTH_SECRET=

# Secures the /api/cron/cleanup route (expired session/verification rows).
# Vercel sets this automatically for Cron Jobs on deploy — you only need
# to set it yourself for local testing. Leave blank locally to skip the
# check entirely.
CRON_SECRET=
# -----------------------------------------------------------------------------
# Database (SQL - Postgres)
# -----------------------------------------------------------------------------
# Postgres connection string used by Drizzle (db client + drizzle-kit CLI).
# Locally: your own Postgres, direct connection (port 5432) is fine.
# In production (Vercel): use Supabase's connection *pooler* string instead
# — Project Settings > Database > Connection pooling, port 6543 — not the
# direct connection. See the comment in `src/db/index.ts` for why.
# One caveat: `db:generate`/`db:migrate` run DDL, which transaction-mode
# poolers (Supabase's default) don't handle well — point DATABASE_URL at
# the direct connection (or the pooler's *session*-mode port) just while
# running those, then switch back for the deployed app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qura

# -----------------------------------------------------------------------------
# OAuth (Google Auth)
# -----------------------------------------------------------------------------
# Google OAuth — leave blank to disable Google sign-in locally.
# Authorized redirect URI changed with the Better Auth migration — update
# this in the Google Cloud console:
# Google OAuth (console.cloud.google.com > APIs & Services > Credentials). 
#   ${APP_URL}/api/auth/callback/google 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Mailing (Gmail Nodemailer)
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465  # 465=secure, 587=non-secure
SMTP_USER=
SMTP_PASSWORD= # 16-char app password (no spaces)